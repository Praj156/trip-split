# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase → Project Settings → Database → Connection string
# Pooled connection (port 6543, transaction mode) used by the app at runtime:
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432) used only by `npm run db:push`:
DIRECT_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Public URL of the deployed site (used for social-share metadata)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
